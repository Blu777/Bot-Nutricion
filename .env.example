# ── Database ────────────────────────────────────────────────────
# Local Docker: use the value below (db = container name in docker-compose)
# Supabase (cloud): postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/nutrition

# ── API ─────────────────────────────────────────────────────────
PORT=3000
# Inside Docker Compose the bot reaches the API via the service name
API_BASE_URL=http://api:3000
# Shared secret between bot and API (set to a strong random string in production)
API_SECRET=change-me-in-production

# ── Telegram ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Gemini ──────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
