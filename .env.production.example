# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database ────────────────────────────────────────────────────
# Uses the 'db' service name as hostname inside Docker Compose
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/nutrition

# ── API ─────────────────────────────────────────────────────────
# Bot reaches the API via the Docker Compose service name
API_BASE_URL=http://api:3000

# ── Telegram ────────────────────────────────────────────────────
# Required — get from @BotFather
TELEGRAM_BOT_TOKEN=CHANGE_ME

# ── Gemini ──────────────────────────────────────────────────────
# Required — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME
